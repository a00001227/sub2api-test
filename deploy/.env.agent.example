# cell-agent 配置 —— 装在每台 cell 主机上,Portal 用 AGENT_TOKEN 远程调它管 cell。
# ⚠ agent 只绑私网/loopback,绝不暴露公网。docker socket 访问 = 等同 host root。

# Portal 调用必须带的 Bearer(每台主机一个)。生成: openssl rand -hex 32
# 同一个值也要填进 Portal「主机注册」表单(Portal 侧 AEAD 加密存)。
AGENT_TOKEN=

# 监听地址。默认 loopback;若 Portal 从内网另一台机调,改成内网网卡 IP:端口(仍不要公网)。
AGENT_BIND_ADDR=127.0.0.1:9099

# 本机对中央/Portal 可达的地址(阶段2 新建 cell 时,cell 用它拼 advertise addr 自注册)。
AGENT_PUBLIC_IP=

# 允许分配给新 cell 的宿主机端口段(阶段2)。防火墙/安全组要预先把这个段整体开好。
AGENT_PORT_RANGE_START=8091
AGENT_PORT_RANGE_END=8190

# cell compose 文件所在目录(含 docker-compose.cell.yml 和各 .env.cellN)。
AGENT_DEPLOY_DIR=/opt/sub2api/deploy
AGENT_COMPOSE_FILE=docker-compose.cell.yml

# 阶段2 渲染 .env.cellN 用的「主机本地大密钥模板」(POSTGRES_PASSWORD/JWT_SECRET/各 token)。
# 阶段0/1 可留空。
AGENT_SECRETS_ENV=/opt/sub2api/deploy/.env.cell.shared

# agent 状态文件(记它创建过的 cell)。留空 = <AGENT_DEPLOY_DIR>/agent-state.json
AGENT_STATE_FILE=
