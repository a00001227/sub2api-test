# =============================================================================
# 边缘 Cell 环境变量模板 —— 复制成 .env.cell1 / .env.cell2 … 每个 cell 一份
# =============================================================================
# 用法:
#   cp .env.cell.example .env.cell1
#   # 改下面的密码/secret/端口/Portal 回调
#   docker compose -p cell1 --env-file .env.cell1 -f docker-compose.cell.yml up -d --build
# 同机多开:cell2 用 -p cell2 --env-file .env.cell2,把 CELL_PORT 改成不同端口即可。
# =============================================================================

# 本 cell 对外端口(同机多开时每个 cell 换不同端口)
CELL_PORT=8091
BIND_HOST=0.0.0.0
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# 本 cell 独立数据库(密码自己设,别和中央一样)
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change_this_cell_db_password
POSTGRES_DB=sub2api

# 本 cell 独立 Redis(可留空不设密码,内部网络不暴露)
REDIS_PASSWORD=
REDIS_DB=0

# 固定 secret(重启不失效);生成:openssl rand -hex 32
JWT_SECRET=change_this_with_openssl_rand_hex_32
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@cell.local
ADMIN_PASSWORD=

# ── Provider Portal 对接 ─────────────────────────────────────────
# 接入面 token:必须和你 Portal 侧配的 SUB2API_INTERNAL_TOKEN / 中央的
# PROVIDER_CONNECT_INTERNAL_TOKEN 一致(Portal 用它调本 cell 的 /internal/provider-*)。
PROVIDER_CONNECT_INTERNAL_TOKEN=your_portal_internal_token

# cell 网关 key(方案 B):cell 信任的"来自中央的转发 key"。设成和中央 EDGE_FORWARD_KEY
# 一样的值。设了之后,cell 收到用该 key 的 /v1 请求即视为"中央可信转发":直接用本地
# 号池执行 + 发 provider 用量(按账号)→ Portal,**不需要在 cell 上建消费者 key/分组**。
# 消费者计费仍在中央。空=不启用(cell 仍按普通消费者网关鉴权,需手动建 key)。
CELL_GATEWAY_KEY=

# 用量回流:本 cell 把用量事件发回 Portal(和中央同一个地址)
PROVIDER_CONNECT_WEBHOOK_URL=https://provider-api-test.cc-max.cc/internal/sub2api/events
PROVIDER_CONNECT_WEBHOOK_SECRET=your_provider_webhook_secret

# ── 自注册 + 心跳(P3,可选)─────────────────────────────────────
# 配齐这三个后,cell 启动会自动向 Portal 注册进 cell 池并周期心跳,无需在
# 后台手动登记;掉线会自动从可分配里摘掉。鉴权复用上面的
# PROVIDER_CONNECT_INTERNAL_TOKEN(= Portal 的 SUB2API_INTERNAL_TOKEN)。
#   CELL_REGISTRY_URL   Portal 注册端点
#   CELL_ADVERTISE_ADDR 本 cell 对外可达地址(Portal 据此访问本 cell)
#   CELL_REGION         本 cell 的地区码(如 sgp)
CELL_REGISTRY_URL=https://provider-api-test.cc-max.cc/internal/cells/register
CELL_ADVERTISE_ADDR=http://REPLACE_WITH_CELL_REACHABLE_ADDR:8091
CELL_REGION=sgp
CELL_NODE=
CELL_HEARTBEAT_SECONDS=30

# ── 上游出口代理(强烈建议配)──────────────────────────────────
# 本 cell 的**所有上游请求**(调 Claude API + OAuth 换码 + token 刷新 + 校验)统一
# 走这个代理出口。目的:
#   1) revoke-safe —— 铸造/使用/刷新走同一固定出口 IP,避免被 Anthropic 吊号;
#   2) 机房/VPS 直连 IP 常在 OAuth 换码时被 Anthropic 边缘 403("Request not allowed"),
#      配一个干净(住宅)出口即可通过。
# 留空 = 不覆盖(按账号代理,没有则直连本机出口)。格式:http/https/socks5,可带 user:pass。
# 例:socks5://user:pass@1.2.3.4:1080  或  http://user:pass@host:port
# ⚠ 必须在**接入(铸造 token)之前**配好;接入完再改出口 IP 会导致号被吊。
CELL_UPSTREAM_PROXY=

# 多出口(Option A,共享 cell 每号自己的 IP)。1/true/on = 开:每个账号走**自己的**
# 按账号代理(接入时从平台 IP 池按 max_bindings 密度分配),CELL_UPSTREAM_PROXY 退化为
# 没有按账号代理的号的兜底出口。留空/关(默认)= 旧行为:CELL_UPSTREAM_PROXY 覆盖整台
# cell 单一出口。两种都 revoke-safe(每号铸造/使用/刷新走它自己那一个固定 IP)。
CELL_MULTI_EGRESS=

# 访问 GitHub/定价数据的代理(可选,和上游无关)
UPDATE_PROXY_URL=
